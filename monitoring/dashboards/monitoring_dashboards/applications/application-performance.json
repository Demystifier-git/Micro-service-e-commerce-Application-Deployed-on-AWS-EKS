    {
      "id": 1,
      "type": "timeseries",
      "title": "P50 Latency",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by(le,service) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
