        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by(service) (rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    }
